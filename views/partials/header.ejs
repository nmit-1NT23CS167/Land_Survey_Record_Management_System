<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Land Survey System</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Source+Sans+3:wght@300;400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/main.css" />
  <%- typeof extraCSS !== 'undefined' ? extraCSS : '' %>
</head>
<body>

<% if (user) { %>
<nav class="navbar navbar-expand-lg navbar-dark lsm-navbar">
  <div class="container-fluid px-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/records/dashboard">
      <span class="brand-icon"><i class="bi bi-map-fill"></i></span>
      <span class="brand-text">LandSurvey<span class="brand-accent">Pro</span></span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link" href="/records/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/records"><i class="bi bi-table"></i> Records</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/records/map"><i class="bi bi-geo-alt-fill"></i> Map View</a>
        </li>
        <% if (user.role === 'admin' || user.role === 'survey_officer') { %>
        <li class="nav-item">
          <a class="nav-link" href="/records/add"><i class="bi bi-plus-circle"></i> Add Record</a>
        </li>
        <% } %>
        <% if (user.role === 'admin') { %>
        <li class="nav-item">
          <a class="nav-link" href="/admin"><i class="bi bi-shield-lock"></i> Admin</a>
        </li>
        <% } %>
      </ul>
      <ul class="navbar-nav">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle user-pill" href="#" data-bs-toggle="dropdown">
            <span class="user-avatar"><%= user.full_name.charAt(0).toUpperCase() %></span>
            <%= user.full_name %>
            <span class="role-badge role-<%= user.role %>"><%= user.role.replace('_', ' ') %></span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/profile"><i class="bi bi-person"></i> Profile</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right"></i> Logout</a></li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>
<% } %>

<main class="<%= user ? 'main-content' : 'auth-main' %>">
  <% if (success && success.length > 0) { %>
    <div class="alert-float"><div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle-fill me-2"></i><%= success[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div></div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="alert-float"><div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div></div>
  <% } %>
