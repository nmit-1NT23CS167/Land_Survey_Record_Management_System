<%- include('../partials/header') %>

<div class="page-header">
  <div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h1 class="page-title"><i class="bi bi-plus-circle-fill"></i> Add Land Record</h1>
        <p class="page-sub">Register a new land survey entry</p>
      </div>
      <a href="/records" class="btn btn-outline-light btn-lsm"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
  </div>
</div>

<div class="container-fluid px-4 py-4">
  <form action="/records/add" method="POST" enctype="multipart/form-data" novalidate>
    <div class="row g-4">

      <!-- Identification -->
      <div class="col-lg-6">
        <div class="lsm-card h-100">
          <div class="lsm-card-header"><i class="bi bi-card-text"></i> Identification</div>
          <div class="lsm-card-body">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label required">Plot Number</label>
                <input type="text" name="plot_number" class="form-control fc-custom" placeholder="PLT-001" required />
              </div>
              <div class="col-md-6">
                <label class="form-label">Survey Number</label>
                <input type="text" name="survey_number" class="form-control fc-custom" placeholder="SRV-2024-001" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Ownership -->
      <div class="col-lg-6">
        <div class="lsm-card h-100">
          <div class="lsm-card-header"><i class="bi bi-person-fill"></i> Ownership Details</div>
          <div class="lsm-card-body">
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label required">Owner Name</label>
                <input type="text" name="owner_name" class="form-control fc-custom" required />
              </div>
              <div class="col-md-6">
                <label class="form-label">Contact Number</label>
                <input type="text" name="owner_contact" class="form-control fc-custom" />
              </div>
              <div class="col-md-6">
                <label class="form-label">Aadhaar / ID Number</label>
                <input type="text" name="owner_aadhaar" class="form-control fc-custom" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Land Details -->
      <div class="col-lg-6">
        <div class="lsm-card h-100">
          <div class="lsm-card-header"><i class="bi bi-tree-fill"></i> Land Details</div>
          <div class="lsm-card-body">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label required">Area</label>
                <input type="text" name="area" class="form-control fc-custom" placeholder="2.5" required />
              </div>
              <div class="col-md-6">
                <label class="form-label">Unit</label>
                <select name="area_unit" class="form-select fc-custom">
                  <% ['acres','hectares','sq_meters','sq_feet','guntha'].forEach(u => { %>
                    <option value="<%= u %>"><%= u.replace('_',' ') %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Land Type</label>
                <select name="land_type" class="form-select fc-custom">
                  <% ['agricultural','residential','commercial','industrial','forest','waste','other'].forEach(t => { %>
                    <option value="<%= t %>"><%= t.charAt(0).toUpperCase() + t.slice(1) %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Land Use</label>
                <input type="text" name="land_use" class="form-control fc-custom" placeholder="Paddy cultivation" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Location -->
      <div class="col-lg-6">
        <div class="lsm-card h-100">
          <div class="lsm-card-header"><i class="bi bi-geo-alt-fill"></i> Location</div>
          <div class="lsm-card-body">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label required">Latitude</label>
                <input type="text" name="lat" id="lat" class="form-control fc-custom" placeholder="12.9716" required />
              </div>
              <div class="col-md-6">
                <label class="form-label required">Longitude</label>
                <input type="text" name="lng" id="lng" class="form-control fc-custom" placeholder="77.5946" required />
              </div>
              <div class="col-12">
                <button type="button" class="btn btn-sm btn-outline-success" onclick="getLocation()">
                  <i class="bi bi-crosshair"></i> Use My Location
                </button>
              </div>
              <div class="col-12">
                <label class="form-label">Address</label>
                <input type="text" name="address" class="form-control fc-custom" />
              </div>
              <div class="col-md-6">
                <label class="form-label">Village</label>
                <input type="text" name="village" class="form-control fc-custom" />
              </div>
              <div class="col-md-6">
                <label class="form-label">Taluka</label>
                <input type="text" name="taluka" class="form-control fc-custom" />
              </div>
              <div class="col-md-6">
                <label class="form-label">District</label>
                <input type="text" name="district" class="form-control fc-custom" />
              </div>
              <div class="col-md-6">
                <label class="form-label">State</label>
                <input type="text" name="state" class="form-control fc-custom" />
              </div>
              <div class="col-md-6">
                <label class="form-label">Country</label>
                <input type="text" name="country" class="form-control fc-custom" value="India" />
              </div>
              <div class="col-md-6">
                <label class="form-label">Pincode</label>
                <input type="text" name="pincode" class="form-control fc-custom" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Survey Dates -->
      <div class="col-lg-6">
        <div class="lsm-card h-100">
          <div class="lsm-card-header"><i class="bi bi-calendar3"></i> Survey Information</div>
          <div class="lsm-card-body">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label required">Survey Date</label>
                <input type="date" name="survey_date" class="form-control fc-custom" required />
              </div>
              <div class="col-md-6">
                <label class="form-label">Registration Date</label>
                <input type="date" name="registration_date" class="form-control fc-custom" />
              </div>
              <div class="col-md-6">
                <label class="form-label">Status</label>
                <select name="status" class="form-select fc-custom">
                  <% ['active','disputed','under_review','transferred','archived'].forEach(s => { %>
                    <option value="<%= s %>"><%= s.replace('_', ' ') %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-12">
                <label class="form-label">Remarks</label>
                <textarea name="remarks" class="form-control fc-custom" rows="3" placeholder="Any additional notes..."></textarea>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- File Uploads -->
      <div class="col-lg-6">
        <div class="lsm-card h-100">
          <div class="lsm-card-header"><i class="bi bi-cloud-upload-fill"></i> Upload Documents</div>
          <div class="lsm-card-body">
            <div class="mb-4">
              <label class="form-label">Ownership Proof Documents</label>
              <p class="form-text">PDF, DOC, DOCX (max 5MB each, up to 5 files)</p>
              <div class="file-drop-zone" id="proofDrop">
                <i class="bi bi-file-earmark-arrow-up"></i>
                <span>Drag & drop or click to select</span>
                <input type="file" name="ownership_proofs" multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" class="file-input" />
              </div>
              <div id="proofPreview" class="file-preview-list"></div>
            </div>
            <div>
              <label class="form-label">Survey Images</label>
              <p class="form-text">JPEG, PNG (max 5MB each, up to 10 images)</p>
              <div class="file-drop-zone" id="imgDrop">
                <i class="bi bi-image"></i>
                <span>Drag & drop or click to select</span>
                <input type="file" name="survey_images" multiple accept=".jpg,.jpeg,.png,.gif" class="file-input" />
              </div>
              <div id="imgPreview" class="file-preview-list"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Submit -->
      <div class="col-12">
        <div class="d-flex gap-3 justify-content-end">
          <a href="/records" class="btn btn-outline-secondary btn-lsm">Cancel</a>
          <button type="submit" class="btn btn-success btn-lsm px-5">
            <i class="bi bi-save me-2"></i>Save Record
          </button>
        </div>
      </div>

    </div>
  </form>
</div>

<% extraJS = `<script>
function getLocation() {
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(pos => {
      document.getElementById('lat').value = pos.coords.latitude.toFixed(6);
      document.getElementById('lng').value = pos.coords.longitude.toFixed(6);
    });
  }
}
</script>`; %>

<%- include('../partials/footer') %>
