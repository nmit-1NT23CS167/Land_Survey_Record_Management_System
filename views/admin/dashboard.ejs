<%- include('../partials/header') %>

<div class="page-header">
  <div class="container-fluid px-4">
    <h1 class="page-title"><i class="bi bi-shield-lock-fill"></i> Admin Panel</h1>
    <p class="page-sub">System administration and user management</p>
  </div>
</div>

<div class="container-fluid px-4 py-4">
  <div class="row g-4 mb-4">
    <div class="col-md-4">
      <div class="stat-card stat-total">
        <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
        <div class="stat-body"><div class="stat-num"><%= totalUsers %></div><div class="stat-label">Total Users</div></div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card stat-active">
        <div class="stat-icon"><i class="bi bi-archive-fill"></i></div>
        <div class="stat-body"><div class="stat-num"><%= totalRecords %></div><div class="stat-label">Land Records</div></div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card stat-review">
        <div class="stat-icon"><i class="bi bi-person-badge-fill"></i></div>
        <div class="stat-body">
          <div class="stat-num"><%= typeof surveyOfficerCount !== 'undefined' ? surveyOfficerCount : 0 %></div>
          <div class="stat-label">Survey Officers</div>
        </div>
      </div>
    </div>
  </div>

  <div class="lsm-card">
    <div class="lsm-card-header d-flex justify-content-between align-items-center">
      <span><i class="bi bi-people-fill"></i> Recent Users</span>
      <a href="/admin/users" class="btn btn-sm btn-outline-light">Manage All Users</a>
    </div>
    <div class="lsm-card-body p-0">
      <div class="table-responsive">
        <table class="table lsm-table mb-0">
          <thead>
            <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Last Login</th><th>Joined</th></tr>
          </thead>
          <tbody>
            <% recentUsers.forEach(u => { %>
            <tr>
              <td><strong><%= u.full_name %></strong></td>
              <td><%= u.email %></td>
              <td><span class="role-badge role-<%= u.role %>"><%= (u.role || '').replace('_',' ') %></span></td>
              <td><span class="status-pill <%= u.is_active ? 'status-active' : 'status-archived' %>"><%= u.is_active ? 'Active' : 'Inactive' %></span></td>
              <td><small><%= u.last_login ? new Date(u.last_login).toLocaleDateString('en-IN') : 'Never' %></small></td>
              <td><small><%= u.created_at ? new Date(u.created_at).toLocaleDateString('en-IN') : 'Unknown' %></small></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
